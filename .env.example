# Jev (TypeSafe): clasificación de piezas. https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
# Opcional: redacción de ángulos y ganchos con Claude. Sin ella se usan plantillas.
ANTHROPIC_API_KEY=
# Opcional: sal para el hash de autores (cámbiala en producción)
RADAR_HASH_SALT=
# Alternativa a TYPESAFE_API_KEY: Jev vía OpenRouter (System One). https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Alternativa a TYPESAFE_API_KEY: Jev vía DigitalOcean Serverless Inference (model access key)
MODEL_ACCESS_KEY=
# Alternativa: OpenCode Zen. Jev gratis por tiempo limitado (jev-1.13-free) y redacción con glm-5.3-flash (de pago, < 1 centavo por reporte).
OPENCODE_API_KEY=
