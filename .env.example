# Jev (TypeSafe): clasificación de piezas. https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
# Opcional: redacción con Claude, si no hay OpenRouter. Sin ningún modelo se usan plantillas.
ANTHROPIC_API_KEY=
# Opcional: sal para el hash de autores (cámbiala en producción)
RADAR_HASH_SALT=
# Jev vía OpenRouter (System One) y redacción con modelos open source (DeepSeek, Nemotron gratis). https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Alternativa a TYPESAFE_API_KEY: Jev vía DigitalOcean Serverless Inference (model access key)
MODEL_ACCESS_KEY=
# Alternativa: OpenCode Zen. Jev gratis por tiempo limitado (jev-1.13-free) y redacción con glm-5.3-flash (de pago, < 1 centavo por reporte).
OPENCODE_API_KEY=
# Opcional: YouTube Data API v3 (gratis, 10.000 unidades/día). Con ella YouTube entra al cálculo de crecimiento.
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=
